# URL do Web App do Google Apps Script (backend/apps-script).
# Sem esta variável, o app usa o localStorage como fallback.
VITE_APPS_SCRIPT_URL=https://script.google.com/a/macros/grupoboticario.com.br/s/***REMOVED***/exec

# Persistência no Firestore (projeto setflow-boti).
# Padrão: true. Use false para forçar localStorage em desenvolvimento.
VITE_FIRESTORE=true

# Persistência no Firestore (projeto setflow-boti).
# O Firestore é a única camada de persistência de dados da aplicação.
# Preencha as chaves abaixo a partir do Console do Firebase
# (Configurações do projeto -> Seus apps -> SDK de configuração do app Web).
VITE_FIREBASE_API_KEY=SEU_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU_PROJETO
VITE_FIREBASE_STORAGE_BUCKET=SEU_PROJETO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=SEU_SENDER_ID
VITE_FIREBASE_APP_ID=SEU_APP_ID
VITE_FIREBASE_MEASUREMENT_ID=SEU_MEASUREMENT_ID
